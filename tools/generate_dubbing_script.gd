extends Node

## Regenerates docs/DUBBING.md from data/voice_manifest.json (PLAN.md §10.5).
##
##   godot --headless --path . res://tools/generate_dubbing_script.tscn
##
## The manifest is the single source of truth. Maintaining a recording script by
## hand alongside it guarantees the two drift apart, and a line recorded under a
## filename the game does not look for is a line nobody will ever hear.
##
## Run this after any manifest change, before booking a recording session.

const OUTPUT_PATH := "res://docs/DUBBING.md"

const SPEAKER_NOTES := {
	"kanca": "Kanca the kancil: warm, bright, encouraging. He is a friend, never a teacher. Never stern, never disappointed, never rushed.",
	"customer_anak": "A child customer, roughly the player's age. Light, a little shy.",
	"customer_ibu": "An adult woman customer. Friendly, everyday warmth.",
	"customer_bapak": "An adult man customer. Relaxed, good-humoured.",
}


func _ready() -> void:
	var lines: Array[String] = []
	lines.append("# Dubbing Script")
	lines.append("")
	lines.append("> Generated from `data/voice_manifest.json` by `tools/generate_dubbing_script.gd`.")
	lines.append("> **Do not edit this file by hand** — edit the manifest and regenerate, or the")
	lines.append("> recording and the game will drift apart.")
	lines.append("")

	var ids: Array[String] = VoiceBank.get_all_voice_ids()
	lines.append("**%d lines, %d clips** once every variant is counted." % [ids.size(), _count_clips(ids)])
	lines.append("")

	lines.append("## Recording and delivery")
	lines.append("")
	lines.append("From PLAN.md §10.1:")
	lines.append("")
	lines.append("- Record at **WAV 48kHz mono**. Masters stay out of the repository.")
	lines.append("- Deliver as **OGG Vorbis, mono, ~96kbps**, normalised to about **-3 dBFS**.")
	lines.append("- Trim leading and trailing silence to under **50ms**. The game inserts its own")
	lines.append("  90ms gap between clips in a composed line; padding inside the file fights it.")
	lines.append("- One clip per row below, at exactly the path given. A file at any other path")
	lines.append("  will not be found — `VoiceBank` reads the manifest and never scans the disk.")
	lines.append("")
	lines.append("### Lines that get assembled")
	lines.append("")
	lines.append("Customer orders are built at runtime from separate clips rather than recorded")
	lines.append("whole (§10.3):")
	lines.append("")
	lines.append("```")
	lines.append("[cust_ibu_open] [num_3] [item_pisang] [cust_ibu_and] [num_1] [item_roti] [cust_ibu_close]")
	lines.append('  "Saya mau beli"  "tiga"  "pisang"        "dan"        "satu"  "roti"      "ya"')
	lines.append("```")
	lines.append("")
	lines.append("So the number and item words have to sit naturally **mid-sentence**, not as")
	lines.append("standalone words with a falling intonation. Read them as if the sentence")
	lines.append("continues, because it does.")
	lines.append("")
	lines.append("### Lines with several variants")
	lines.append("")
	lines.append("A child hears these dozens of times per session. Where a line lists more than")
	lines.append("one take, make them **genuinely different** — different wording is welcome, not")
	lines.append("just a different reading of the same words. Identical praise every time is what")
	lines.append("makes an app feel mechanical (§10.4).")
	lines.append("")

	var by_speaker: Dictionary = {}
	for voice_id: String in ids:
		var speaker: String = _speaker_of(voice_id)
		if not by_speaker.has(speaker):
			by_speaker[speaker] = [] as Array[String]
		(by_speaker[speaker] as Array[String]).append(voice_id)

	var speakers: Array[String] = []
	for key: String in by_speaker:
		speakers.append(key)
	speakers.sort()

	for speaker: String in speakers:
		var entries: Array[String] = by_speaker[speaker]
		lines.append("## %s" % speaker)
		lines.append("")
		if SPEAKER_NOTES.has(speaker):
			lines.append("*%s*" % SPEAKER_NOTES[speaker])
			lines.append("")
		lines.append("%d lines, %d clips." % [entries.size(), _count_clips(entries)])
		lines.append("")
		lines.append("| Voice ID | Takes | Line (Bahasa Indonesia) | File |")
		lines.append("|---|---|---|---|")
		for voice_id: String in entries:
			var variants: int = VoiceBank.get_variant_count(voice_id)
			lines.append("| `%s` | %d | %s | `%s` |" % [
				voice_id,
				variants,
				VoiceBank.get_text(voice_id),
				_file_pattern(voice_id, variants),
			])
		lines.append("")

	lines.append("## Checking progress")
	lines.append("")
	lines.append("```powershell")
	lines.append("& $env:GODOT --headless --path . res://tools/check_voice_coverage.tscn")
	lines.append("```")
	lines.append("")
	lines.append("Until a file exists, the game logs the voice ID and waits out the line's")
	lines.append("duration in silence, so everything stays playable while recording is in")
	lines.append("progress (§10.5).")

	var file: FileAccess = FileAccess.open(OUTPUT_PATH, FileAccess.WRITE)
	if file == null:
		Log.e("Cannot write %s: %s" % [OUTPUT_PATH, error_string(FileAccess.get_open_error())], "Dubbing")
		get_tree().quit(1)
		return

	file.store_string("\n".join(lines) + "\n")
	file.close()

	print("Wrote %s (%d lines, %d clips)" % [OUTPUT_PATH, ids.size(), _count_clips(ids)])
	get_tree().quit(0)


func _file_pattern(voice_id: String, variants: int) -> String:
	var first: String = VoiceBank.resolve_path(voice_id, 0).trim_prefix("res://")
	if variants <= 1:
		return first
	var last: String = VoiceBank.resolve_path(voice_id, variants - 1).get_file()
	return "%s … %s" % [first, last]


func _count_clips(ids: Array[String]) -> int:
	var total: int = 0
	for voice_id: String in ids:
		total += VoiceBank.get_variant_count(voice_id)
	return total


func _speaker_of(voice_id: String) -> String:
	var manifest: Dictionary = ContentDB.get_voice_manifest()
	var entry: Dictionary = manifest.get(voice_id, {}) as Dictionary
	return String(entry.get("speaker", "unknown"))
